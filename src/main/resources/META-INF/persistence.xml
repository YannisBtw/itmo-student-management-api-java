<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="studentPU" transaction-type="JTA">

        <jta-data-source>jdbc/StudentDS</jta-data-source>

        <class>ru.itmo.weblab3.entity.Student</class>
        <class>ru.itmo.weblab3.entity.User</class>
        <class>ru.itmo.weblab3.entity.RefreshToken</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action"
                      value="create"/>
        </properties>

    </persistence-unit>

</persistence>
